<!--
  THIS FILE IS NO LONGER USED DIRECTLY — kept only as a reference example.

  The real plist is now GENERATED automatically by install-launchd.sh, which
  bakes in the correct absolute project path and the correct absolute node
  binary path for THIS Mac, then installs it to ~/Library/LaunchAgents/.

  Why the change: this file used to be hand-edited, and drifted out of sync
  twice — once pointing at an old "V3 automation/spurs-modular" folder instead
  of this project, and once calling bare `node` which launchd couldn't resolve
  because it doesn't source .zshrc/.bash_profile. Both classes of bug are
  eliminated by generating the file at install time instead of hand-editing it.

  To (re)install: ./automation/install-launchd.sh
  To uninstall:   ./automation/install-launchd.sh uninstall
-->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.thfc.dailyupdate</string>

    <key>ProgramArguments</key>
    <array>
        <string>/absolute/path/to/node</string>
        <string>/absolute/path/to/spurs-modular-v6/automation/update-dashboard.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/absolute/path/to/spurs-modular-v6</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/absolute/path/to/spurs-modular-v6/automation/run-output.log</string>

    <key>StandardErrorPath</key>
    <string>/absolute/path/to/spurs-modular-v6/automation/run-error.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
